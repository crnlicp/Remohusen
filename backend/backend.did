type Testimonial = 
 record {
   active: bool;
   avatar: opt ImageRef;
   id: nat;
   name: text;
   order: nat;
   quote: L10n;
   rating: nat;
   role: L10n;
 };
type TeamMember = 
 record {
   name: text;
   photo: opt ImageRef;
   role: L10n;
 };
type SocialLinks = 
 record {
   facebook: text;
   instagram: text;
   linkedin: text;
 };
type Slide = 
 record {
   active: bool;
   ctaLink: text;
   ctaText: L10n;
   id: nat;
   image: ImageRef;
   order: nat;
   subtitle: L10n;
   title: L10n;
 };
type SiteContent = 
 record {
   about: AboutPage;
   contact: ContactInfo;
   latestNews: vec NewsPost;
   projects: vec Project;
   seo: SeoSettings;
   services: vec Service;
   settings: Settings;
   slides: vec Slide;
   testimonials: vec Testimonial;
 };
type SharedDocumentInput =
 record {
   customerAddress: text;
   customerName: text;
   customerType: text;
   customerVat: text;
   dueDate: text;
   issueDate: text;
   kind: text;
   language: text;
   lines: vec DocumentLine;
   notes: text;
   project: text;
   rotOre: nat;
   sourceId: opt nat;
   supplyDate: text;
   terms: text;
   title: text;
 };
type SharedDocumentInfo =
 record {
   brand: DocumentBrand;
   chunks: nat;
   expiresAt: int;
   hash: text;
   input: SharedDocumentInput;
   issuedAt: int;
   language: text;
   number: text;
   sourceNumber: text;
   title: text;
   totals: DocumentTotals;
 };
type Settings = 
 record {
   companyName: text;
   footerText: L10n;
   orgNumber: text;
   rotNotice: L10n;
   socials: SocialLinks;
   tagline: L10n;
 };
type Session = 
 record {
   expiresAt: int;
   username: text;
 };
type Service = 
 record {
   active: bool;
   description: L10n;
   icon: text;
   id: nat;
   image: opt ImageRef;
   order: nat;
   title: L10n;
 };
type SeoSettings = 
 record {
   about: PageMeta;
   allowIndexing: bool;
   areaServed: text;
   bingVerification: text;
   businessType: text;
   contact: PageMeta;
   googleVerification: text;
   home: PageMeta;
   keywords: L10n;
   news: PageMeta;
   ogImage: text;
   priceRange: text;
   siteUrl: text;
 };
type Result_9 =
 variant {
   err: text;
   ok: record {
         items: vec DocumentSummary;
         nextOffset: opt nat;
       };
 };
type Result_8 =
 variant {
   err: text;
   ok: vec ImageInfo;
 };
type Result_7 = 
 variant {
   err: text;
   ok: vec Message;
 };
type Result_6 = 
 variant {
   err: text;
   ok: BusinessDocument;
 };
type Result_5 = 
 variant {
   err: text;
   ok: record {
         expiresAt: int;
         token: text;
       };
 };
type Result_4 = 
 variant {
   err: text;
   ok: SharedDocumentInfo;
 };
type Result_3 = 
 variant {
   err: text;
   ok: blob;
 };
type Result_2 = 
 variant {
   err: text;
   ok: text;
 };
type Result_13 =
 variant {
   err: text;
   ok: DashboardStats;
 };
type Result_12 =
 variant {
   err: text;
   ok: ImageInfo;
 };
type Result_11 =
 variant {
   err: text;
   ok: AdminContent;
 };
type Result_10 =
 variant {
   err: text;
   ok: opt DocumentSettings;
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type Project = 
 record {
   category: L10n;
   description: L10n;
   featured: bool;
   id: nat;
   images: vec ImageRef;
   location: text;
   order: nat;
   title: L10n;
   year: text;
 };
type PageMeta = 
 record {
   description: L10n;
   title: L10n;
 };
type NewsPost = 
 record {
   body: L10n;
   cover: opt ImageRef;
   createdAt: int;
   excerpt: L10n;
   id: nat;
   published: bool;
   publishedAt: int;
   title: L10n;
   updatedAt: int;
 };
type MessageInput = 
 record {
   body: text;
   email: text;
   name: text;
   phone: text;
   subject: text;
 };
type Message = 
 record {
   body: text;
   createdAt: int;
   email: text;
   id: nat;
   name: text;
   phone: text;
   read: bool;
   subject: text;
 };
type L10n = 
 record {
   en: text;
   sv: text;
 };
type ImageRef = 
 variant {
   stored: nat;
   url: text;
 };
type ImageInfo = 
 record {
   chunkCount: nat;
   createdAt: int;
   id: nat;
   mime: text;
   name: text;
   size: nat;
 };
type DocumentTotals =
 record {
   grossOre: nat;
   netOre: nat;
   payableOre: nat;
   vatOre: nat;
 };
type DocumentSummary =
 record {
   archived: bool;
   customerName: text;
   id: nat;
   issueDate: text;
   issued: bool;
   kind: text;
   number: text;
   pdfReady: bool;
   title: text;
 };
type DocumentSettings =
 record {
   accountingMethod: text;
   archiveService: text;
   brand: DocumentBrand;
   employees: text;
   financialYearEnd: text;
   invoicePrefix: text;
   partnerType: text;
   paymentDays: nat;
   privacyApproved: bool;
   vatPeriod: text;
   vatRegistered: text;
 };
type DocumentPayment =
 record {
   amountOre: nat;
   date: text;
   reference: text;
 };
type DocumentLine =
 record {
   category: text;
   description: text;
   discountBps: nat;
   exemptionReason: text;
   quantityMilli: nat;
   treatment: text;
   unitOre: nat;
   vatBps: nat;
 };
type DocumentInput =
 record {
   customerAddress: text;
   customerName: text;
   customerType: text;
   customerVat: text;
   dueDate: text;
   internalNotes: text;
   issueDate: text;
   kind: text;
   language: text;
   lines: vec DocumentLine;
   notes: text;
   project: text;
   reverseChargeConfirmed: bool;
   rotConfirmed: bool;
   rotOre: nat;
   sourceId: opt nat;
   supplyDate: text;
   terms: text;
   title: text;
 };
type DocumentEvidence =
 record {
   acceptanceReference: text;
   archiveReference: text;
   einvoiceReference: text;
 };
type DocumentEvent =
 record {
   action: text;
   at: int;
   detail: text;
 };
type DocumentBrand =
 record {
   address: text;
   contact: text;
   fTax: bool;
   footer: L10n;
   header: L10n;
   legalName: text;
   logoData: text;
   orgNumber: text;
   paymentDetails: text;
   vatNumber: text;
 };
type DashboardStats = 
 record {
   images: nat;
   messages: nat;
   news: nat;
   projects: nat;
   publishedNews: nat;
   services: nat;
   slides: nat;
   testimonials: nat;
   unreadMessages: nat;
 };
type ContactInfo = 
 record {
   address: text;
   city: text;
   email: text;
   heroImage: opt ImageRef;
   intro: L10n;
   mapLat: text;
   mapLng: text;
   openingHours: L10n;
   phone: text;
   postalCode: text;
   title: L10n;
 };
type BusinessDocument =
 record {
   brand: DocumentBrand;
   createdAt: int;
   events: vec DocumentEvent;
   evidence: DocumentEvidence;
   id: nat;
   input: DocumentInput;
   issuedAt: opt int;
   number: text;
   payments: vec DocumentPayment;
   pdfChunks: nat;
   pdfHash: text;
   pdfReady: bool;
   revision: nat;
   shareHash: opt text;
   sourceNumber: text;
   totals: DocumentTotals;
 };
type AdminContent = 
 record {
   about: AboutPage;
   contact: ContactInfo;
   news: vec NewsPost;
   projects: vec Project;
   seo: SeoSettings;
   services: vec Service;
   settings: Settings;
   slides: vec Slide;
   testimonials: vec Testimonial;
 };
type AboutValue = 
 record {
   icon: text;
   "text": L10n;
   title: L10n;
 };
type AboutStat = 
 record {
   caption: L10n;
   value: text;
 };
type AboutPage = 
 record {
   heroImage: opt ImageRef;
   heroText: L10n;
   heroTitle: L10n;
   stats: vec AboutStat;
   storyImage: opt ImageRef;
   storyText: L10n;
   storyTitle: L10n;
   team: vec TeamMember;
   values: vec AboutValue;
 };
service : {
  adminBeginUpload: (token: text, name: text, mime: text, size: nat) ->
   (Result);
  adminDashboard: (token: text) -> (Result_13) query;
  adminDeleteDocumentDraft: (token: text, id: nat) -> (Result_1);
  adminDeleteImage: (token: text, id: nat) -> (Result_1);
  adminDeleteMessage: (token: text, id: nat) -> (Result_1);
  adminDeleteNews: (token: text, id: nat) -> (Result_1);
  adminDeleteProject: (token: text, id: nat) -> (Result_1);
  adminDeleteService: (token: text, id: nat) -> (Result_1);
  adminDeleteSlide: (token: text, id: nat) -> (Result_1);
  adminDeleteTestimonial: (token: text, id: nat) -> (Result_1);
  adminDocumentPdfChunk: (token: text, id: nat, index: nat) ->
   (Result_3) query;
  adminFinaliseDocumentPdf: (token: text, id: nat, expectedHash: text) ->
   (Result_6);
  adminFinishUpload: (token: text, uploadId: nat) -> (Result_12);
  adminGetContent: (token: text) -> (Result_11) query;
  adminGetDocument: (token: text, id: nat) -> (Result_6) query;
  adminGetDocumentSettings: (token: text) -> (Result_10) query;
  adminIssueDocument: (token: text, id: nat, revision: nat) -> (Result_6);
  adminListDocuments: (token: text, offset: nat) -> (Result_9) query;
  adminListImages: (token: text) -> (Result_8) query;
  adminListMessages: (token: text) -> (Result_7) query;
  adminRecordDocumentPayment: (token: text, id: nat, payment:
   DocumentPayment) -> (Result_1);
  adminResetDocumentPdf: (token: text, id: nat) -> (Result_1);
  adminRevokeDocumentShare: (token: text, id: nat) -> (Result_1);
  adminSaveAbout: (token: text, about: AboutPage) -> (Result_1);
  adminSaveContact: (token: text, contact: ContactInfo) -> (Result_1);
  adminSaveDocument: (token: text, id: nat, revision: nat, input:
   DocumentInput) -> (Result_6);
  adminSaveDocumentEvidence: (token: text, id: nat, evidence:
   DocumentEvidence) -> (Result_1);
  adminSaveDocumentSettings: (token: text, settings: DocumentSettings) ->
   (Result_1);
  adminSaveNews: (token: text, post: NewsPost) -> (Result);
  adminSaveProject: (token: text, project: Project) -> (Result);
  adminSaveSeo: (token: text, seo: SeoSettings) -> (Result_1);
  adminSaveService: (token: text, "service": Service) -> (Result);
  adminSaveSettings: (token: text, settings: Settings) -> (Result_1);
  adminSaveSlide: (token: text, slide: Slide) -> (Result);
  adminSaveTestimonial: (token: text, testimonial: Testimonial) -> (Result);
  adminSetMessageRead: (token: text, id: nat, read: bool) -> (Result_1);
  adminShareDocument: (token: text, id: nat) -> (Result_5);
  adminUploadChunk: (token: text, uploadId: nat, index: nat, data: blob) ->
   (Result_1);
  adminUploadDocumentPdf: (token: text, id: nat, index: nat, chunk: blob) ->
   (Result_1);
  bootstrapAdmin: (username: text, password: text) -> (Result_1);
  changePassword: (token: text, currentPassword: text, newPassword: text) ->
   (Result_1);
  getImageChunk: (id: nat, index: nat) -> (opt blob) query;
  getImageInfo: (id: nat) -> (opt ImageInfo) query;
  getNewsPost: (id: nat) -> (opt NewsPost) query;
  getSharedDocument: (token: text) -> (Result_4) query;
  getSharedDocumentPdfChunk: (token: text, index: nat) -> (Result_3) query;
  getSiteContent: () -> (SiteContent) query;
  isAdminConfigured: () -> (bool) query;
  listNews: () -> (vec NewsPost) query;
  login: (username: text, password: text) -> (Result_2);
  logout: (token: text) -> ();
  resetAdminCredentials: (username: text, password: text) -> (Result_1);
  sessionInfo: (token: text) -> (opt Session) query;
  submitMessage: (input: MessageInput) -> (Result);
}
